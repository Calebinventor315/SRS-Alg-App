# Copy this file to .env and fill in your Supabase project credentials
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free AI Deck Generator (add this in Vercel -> Settings -> Environment Variables)
# Get a free key at https://openrouter.ai/keys (no credit card required for :free Chinese models like Qwen & DeepSeek)
OPENROUTER_API_KEY=sk-or-v1-your-free-openrouter-key
